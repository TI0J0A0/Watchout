<?xml version="1.0" encoding="utf-8"?>
<!--
  The site is served over HTTPS (HSTS). Cleartext is denied by default;
  this config only permits it for funnyroll.com in case a plain-http
  redirect is ever hit during development. Remove the domain-config block
  for a strict HTTPS-only build.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">funnyroll.com</domain>
    </domain-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
