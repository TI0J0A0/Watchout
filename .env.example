# Base URL of your TMDB proxy (the VPS endpoint that injects the API key).
# No trailing slash. The frontend calls `${VITE_TMDB_PROXY_URL}/<tmdb-path>`.
# Leave empty to disable TMDB and keep using Jikan/AniList/Kitsu only.
# Example: VITE_TMDB_PROXY_URL=https://api.yoursite.com/tmdb
VITE_TMDB_PROXY_URL=
